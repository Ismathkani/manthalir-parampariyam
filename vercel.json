{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/manthalir-parampariyam1/browser",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|images/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
