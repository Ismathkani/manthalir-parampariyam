{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/manthalir-parampariyam1/browser",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|uploads/|images/).*)",
      "destination": "/index.html"
    }
  ]
}
